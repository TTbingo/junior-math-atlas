  "schema": 1,
  "note": "体系依据《中考冲刺专题突破·数学》(2024)：第一部分 31 讲、第二部分 31 微专题、第三部分 25 微专题。",
  "modules": [
    {
      "id": "m1",
      "no": 1,
      "title": "第一部分 · 玩转基础",
      "short": "基础",
      "desc": "31 讲覆盖中考全部考点：数与式、方程与不等式、函数、三角形与四边形、相似、圆、图形变换、统计与概率。先把概念和定理的来路讲清，再练基础题型。",
      "strand": "图形与几何 / 数与代数 / 统计与概率"
    },
    {
      "id": "m2",
      "no": 2,
      "title": "第二部分 · 专题专练",
      "short": "专题",
      "desc": "31 个微专题，把中考高频模型一次讲透：全等的四种辅助线、相似的四种结构、圆与最值的四类构图、函数与应用的固定套路。每个专题只回答两件事——识别信号是什么，为什么要这样作辅助线。",
      "strand": "图形与几何 / 数与代数 / 综合与实践"
    },
    {
      "id": "m3",
      "no": 3,
      "title": "第三部分 · 满分突破",
      "short": "满分",
      "desc": "25 个压轴微专题：图形变换、最值与定值、隐形圆、存在性、双曲线与抛物线综合、新定义。目标不是多做题，而是看到条件就能判断该调用哪一套构图。",
      "strand": "图形与几何 / 数与代数 / 综合与实践"
    }
  ],
