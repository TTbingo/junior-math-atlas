{
  "schema": 1,
  "note": "体系依据《初中数学思维导图》十一章脉络，重组为代数 / 几何 / 统计与概率三大领域；《中考冲刺专题突破》作为内容与例题的来源参照。",
  "modules": [
    {
      "id": "m1",
      "no": 1,
      "title": "代数",
      "short": "代数",
      "strand": "数与代数",
      "desc": "用符号表示关系，用运算求解关系：实数 → 式子 → 方程 → 函数。",
      "map": "map-algebra.svg"
    },
    {
      "id": "m2",
      "no": 2,
      "title": "几何",
      "short": "几何",
      "strand": "图形与几何",
      "desc": "从直观确认到演绎推理：线与角 → 三角形 → 四边形 → 圆 → 相似与变换。",
      "map": "map-geometry.svg"
    },
    {
      "id": "m3",
      "no": 3,
      "title": "统计与概率",
      "short": "统计概率",
      "strand": "统计与概率",
      "desc": "用数据说话，用可能性判断：收数据 → 画图 → 算统计量 → 估概率。",
      "map": "map-statistics.svg"
    }
  ],
  "topics": [
    {
      "id": "m1-01",
      "module": "m1",
      "no": 1,
      "title": "数与式",
      "desc": "实数是根，整式与分式是运算语言，二次根式把开方也纳入同一套运算法则。",
      "points": [
        "m1-01-01-real-numbers",
        "m1-01-02-integral-expressions",
        "m1-01-03-algebraic-fractions",
        "m1-01-04-quadratic-radicals"
      ]
    },
    {
      "id": "m1-02",
      "module": "m1",
      "no": 2,
      "title": "方程与不等式",
      "desc": "方程是「已知关系求未知量」的工具，不等式把等号换成不等号，解法母体完全一致。",
      "points": [
        "m1-02-01-linear-equation",
        "m1-02-02-linear-system",
        "m1-02-03-quadratic-equation",
        "m1-02-04-discriminant-vieta",
        "m1-02-05-fractional-equation",
        "m1-02-06-inequality",
        "m1-02-07-equation-word-problems"
      ]
    },
    {
      "id": "m1-03",
      "module": "m1",
      "no": 3,
      "title": "函数",
      "desc": "函数是研究变化的语言：一次函数匀速、反比例函数成反比、二次函数先减后增。",
      "points": [
        "m1-03-01-coordinates-and-function",
        "m1-03-02-linear-function",
        "m1-03-03-inverse-proportion",
        "m1-03-04-quadratic-function"
      ]
    },
    {
      "id": "m2-01",
      "module": "m2",
      "no": 1,
      "title": "图形的初步认识",
      "desc": "点、线、角是几何的字母表，平行线的性质是把角搬来搬去的传送带。",
      "points": [
        "m2-01-01-lines-rays-segments",
        "m2-01-02-angles",
        "m2-01-03-parallel-lines"
      ]
    },
    {
      "id": "m2-02",
      "module": "m2",
      "no": 2,
      "title": "三角形",
      "desc": "三角形是最简单的封闭图形，也是全部几何推理的主战场。",
      "points": [
        "m2-02-01-triangle-basics",
        "m2-02-02-congruent-triangles",
        "m2-02-03-isosceles-triangle",
        "m2-02-04-pythagoras"
      ]
    },
    {
      "id": "m2-03",
      "module": "m2",
      "no": 3,
      "title": "四边形",
      "desc": "四边形靠对角线拆成三角形来处理，特殊四边形是加了限制条件的平行四边形。",
      "points": [
        "m2-03-01-polygon",
        "m2-03-02-parallelogram",
        "m2-03-03-special-parallelogram",
        "m2-03-04-trapezoid"
      ]
    },
    {
      "id": "m2-04",
      "module": "m2",
      "no": 4,
      "title": "圆",
      "desc": "圆的性质几乎都藏在半径、弦、圆心角这三样东西的组合里。",
      "points": [
        "m2-04-01-circle-properties",
        "m2-04-02-circle-position",
        "m2-04-03-arc-sector-cone",
        "m2-04-04-regular-polygon"
      ]
    },
    {
      "id": "m2-05",
      "module": "m2",
      "no": 5,
      "title": "相似与投影",
      "desc": "相似是「形状不变、大小可变」，投影是三视图背后的光线模型。",
      "points": [
        "m2-05-01-similar-triangles",
        "m2-05-02-homothety",
        "m2-05-03-projection-views"
      ]
    },
    {
      "id": "m2-06",
      "module": "m2",
      "no": 6,
      "title": "图形与变换",
      "desc": "平移、旋转、轴对称都是全等变换，变换把分散的条件搬到一起。",
      "points": [
        "m2-06-01-symmetry",
        "m2-06-02-translation-rotation",
        "m2-06-03-transform-coordinates"
      ]
    },
    {
      "id": "m2-07",
      "module": "m2",
      "no": 7,
      "title": "锐角三角函数",
      "desc": "三角函数把直角三角形的边与角连成比例关系，是测量问题的通用工具。",
      "points": [
        "m2-07-01-trig-ratios",
        "m2-07-02-solving-right-triangle"
      ]
    },
    {
      "id": "m3-01",
      "module": "m3",
      "no": 1,
      "title": "统计",
      "desc": "先收数据、再画图、最后用统计量概括，三步走完一次数据分析。",
      "points": [
        "m3-01-01-data-collection",
        "m3-01-02-statistical-charts",
        "m3-01-03-central-tendency",
        "m3-01-04-variance"
      ]
    },
    {
      "id": "m3-02",
      "module": "m3",
      "no": 2,
      "title": "概率",
      "desc": "概率是可能性的度量：先分清事件类型，再用列举或频率把它算出来。",
      "points": [
        "m3-02-01-event-probability",
        "m3-02-02-probability-methods",
        "m3-02-03-frequency-estimate"
      ]
    }
  ],
